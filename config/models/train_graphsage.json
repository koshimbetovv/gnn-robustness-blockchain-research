{
  "seed": 42,
  "data": {
    "feature_path": "data/raw/elliptic/elliptic_txs_features.csv",
    "class_path": "data/raw/elliptic/elliptic_txs_classes.csv",
    "edge_path": "data/raw/elliptic/elliptic_txs_edgelist.csv",
    "train_start": 1,
    "train_end": 34,
    "test_start": 35,
    "test_end": 49,
    "filter_unknown": false
  },
  "model": {
    "hidden_dim": 128,
    "aggr": "mean",
    "out_dim": 2
  },
  "training": {
    "epochs": 500,
    "lr": 0.005,
    "weight_decay": 0.0005,
    "grad_clip": 1.0,
    "adam_eps": 1e-05,
    "log_every": 50,
    "use_class_weights": true
  },
  "save": {
    "save_dir": "models",
    "save_run": true,
    "prefix": "graphsage",
    "filename": "graphsage.pt"
  }
}
